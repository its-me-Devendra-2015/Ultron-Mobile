# LiveKit Cloud project settings (keep the API secret server-side only)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# Optional: set only when using explicit dispatch (must match worker registration)
LIVEKIT_AGENT_NAME=my-agent

# Firebase Admin SDK service-account JSON path, mounted securely at runtime.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# Optional comma-separated frontend origins. Leave empty for native-only clients.
CORS_ALLOWED_ORIGINS=
